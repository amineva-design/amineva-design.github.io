---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAbout, getSettings, richText, resumeHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const about = await getAbout();
const s = await getSettings();
const resume = resumeHref(s, lang);

// Навыки, инструменты и софт-скиллы — три карточки, как на прежнем сайте:
// «Навыки» высокая слева, «Инструменты» и «Софт-скиллы» справа друг под другом
const lines = (v: string) => v.split('\n').map((x) => x.trim()).filter(Boolean);
const kitTools = [
  ...about.tools.map((g) => ({ name: L(g, 'name'), text: L(g, 'details') })),
  ...(L(about, 'languages') ? [{ name: tx.languages, text: L(about, 'languages') }] : []),
];
---

<Base title={tx.aboutTitle} description={L(about, 'text')} lang={lang}>
  <section class="container about">
    <a class="back" href={href(lang, '/')}><svg class="back__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3 5.5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>{tx.backHome}</a>
    <h1 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h1>

    <div class="about__grid">
      <div class="rich about__text" set:html={richText(L(about, 'text'))} />
      <div class="about__photos">
        {
          about.photos.map(
            (p, i) =>
              p && (
                <figure class:list={['ph', `ph--${i}`]}>
                  <Image src={p} alt="" widths={[360, 720]} sizes="(max-width: 720px) 50vw, 25vw" loading={i < 2 ? 'eager' : 'lazy'} />
                </figure>
              )
          )
        }
      </div>
      {L(about, 'hobbies') && <p class="about__hobbies">{L(about, 'hobbies')}</p>}
    </div>
  </section>

  {
    about.experience.length > 0 && (
      <section class="container block">
        <div class="block__head">
          <h2>{tx.experience}</h2>
          {resume && (
            <a class="link-arrow" href={resume} target="_blank" rel="noopener">
              {tx.fullResume}
            </a>
          )}
        </div>
        <ol class="timeline">
          {about.experience.map((e) => (
            <li data-reveal="fade">
              <span class="label">{L(e, 'period')}</span>
              <div>
                <h3>{L(e, 'company')}</h3>
                <p class="timeline__role">{L(e, 'role')}</p>
                {L(e, 'text') && <p class="timeline__text">{L(e, 'text')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="container block block--last">
    <div class="kit">
      <article class="kcard kcard--skills" data-reveal="fade">
        <h2>{tx.skills}</h2>
        {about.skills.map((g) => (
          <div class="kcard__group">
            <h3>{L(g, 'title')}</h3>
            {lines(L(g, 'items')).map((i) => <p>{i}</p>)}
          </div>
        ))}
      </article>

      <article class="kcard kcard--tools" data-reveal="fade">
        <h2>{tx.tools}</h2>
        <dl>
          {kitTools.map((t) => (
            <div class="kcard__row">
              <dt>{t.name}</dt>
              <dd>{t.text}</dd>
            </div>
          ))}
        </dl>
      </article>

      <article class="kcard kcard--soft" data-reveal="fade">
        <h2>{tx.softSkills}</h2>
        {about.softSkills.map((g) => (
          <div class="kcard__group">
            <h3>{L(g, 'title')}</h3>
            <p>{L(g, 'text')}</p>
          </div>
        ))}
      </article>
    </div>
  </section>
</Base>

<style>
  .about {
    padding-top: clamp(24px, 3vw, 40px);
  }
  .back {
    display: inline-flex;
    margin-bottom: clamp(20px, 2.4vw, 32px);
    padding: 8px 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  /* тот же размер, что у заголовков секций на главной («Кейсы», «Стек») */
  .about__headline {
    max-width: 900px;
    font-size: var(--fs-h2);
    letter-spacing: -0.03em;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(24px, 3vw, 40px);
    align-items: start;
  }
  .about__text {
    grid-column: 1 / 5;
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.55;
  }
  .about__photos {
    grid-column: 6 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .ph:hover :global(img) {
    filter: none;
  }
  .ph {
    aspect-ratio: 4 / 5;
  }
  .about__hobbies {
    grid-column: 6 / 13;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .block {
    padding-top: clamp(48px, 6vw, 96px);
  }
  .block--last {
    padding-bottom: clamp(64px, 9vw, 128px);
  }

  /* Навыки / Инструменты / Софт-скиллы: три карточки на общей сетке (линии 1-й и 6-й колонок) */
  .kit {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: var(--gap);
  }
  .kcard {
    padding: clamp(28px, 3.4vw, 52px);
    border-radius: var(--radius);
    background: var(--card);
  }
  /* названия карточек — фирменным зелёным */
  .block .kcard h2 {
    color: var(--accent);
    margin-bottom: clamp(20px, 2vw, 28px);
    font-size: var(--fs-h3);
  }
  .kcard h3 {
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .kcard p,
  .kcard dd {
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.45;
  }
  .kcard__group + .kcard__group {
    margin-top: clamp(16px, 1.8vw, 24px);
  }
  .kcard--skills {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
  }
  .kcard--tools {
    grid-column: 6 / 13;
    grid-row: 1;
  }
  .kcard--soft {
    grid-column: 6 / 13;
    grid-row: 2;
  }

  .kcard dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .kcard__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: 16px;
    align-items: baseline;
  }
  .kcard dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(16px, 1.4vw, 19px);
  }
  @media (max-width: 900px) {
    .kcard--skills,
    .kcard--tools,
    .kcard--soft {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .kcard__row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .block h2 {
    font-size: var(--fs-h2);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .timeline li > .label {
    grid-column: 1 / 6;
    font-size: 15px;
    padding-top: 6px;
  }
  .timeline li > div {
    grid-column: 6 / 13;
  }
  .timeline h3 {
    font-size: var(--fs-h3);
  }
  .timeline__role {
    margin-top: 6px;
    font-weight: 600;
  }
  .timeline__text {
    margin-top: 10px;
    color: var(--muted);
    max-width: 680px;
  }


















  @media (max-width: 900px) {
    .about__text,
    .about__photos,
    .about__hobbies {
      grid-column: 1 / -1;
    }
  
  
    .timeline li > .label,
    .timeline li > div {
      grid-column: 1 / -1;
    }
    .timeline li {
      row-gap: 4px;
    }
  }
  @media (max-width: 560px) {
    .block__head {
      flex-direction: column;
    }
  }
</style>
