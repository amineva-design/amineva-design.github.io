---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAbout, getSettings, richText, resumeHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const about = await getAbout();
const s = await getSettings();
const resume = resumeHref(s, lang);

// Навыки, инструменты и софт-скиллы — один общий блок: слева раздел, справа строки «название + описание»
const lines = (v: string) => v.split('\n').map((x) => x.trim()).filter(Boolean);
const kit = [
  {
    label: tx.skills,
    rows: about.skills.map((g) => ({ title: L(g, 'title'), text: lines(L(g, 'items')).join(' · ') })),
  },
  {
    label: tx.tools,
    rows: [
      ...about.tools.map((g) => ({ title: L(g, 'name'), text: L(g, 'details').split(',').map((x) => x.trim()).filter(Boolean).join(' / ') })),
      ...(L(about, 'languages') ? [{ title: tx.languages, text: L(about, 'languages') }] : []),
    ],
  },
  {
    label: tx.softSkills,
    rows: about.softSkills.map((g) => ({ title: L(g, 'title'), text: L(g, 'text') })),
  },
].filter((g) => g.rows.length > 0);
---

<Base title={tx.aboutTitle} description={L(about, 'text')} lang={lang}>
  <section class="container about">
    <a class="back" href={href(lang, '/')}>{tx.backHome}</a>
    <p class="about__label label" data-reveal="fade">{tx.aboutLabel}</p>
    <h1 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h1>

    <div class="about__grid">
      <div class="rich about__text" set:html={richText(L(about, 'text'))} />
      <div class="about__photos">
        {
          about.photos.map(
            (p, i) =>
              p && (
                <figure class:list={['ph', `ph--${i}`]}>
                  <Image src={p} alt="" widths={[360, 720]} sizes="(max-width: 720px) 50vw, 25vw" loading={i < 2 ? 'eager' : 'lazy'} />
                </figure>
              )
          )
        }
      </div>
      {L(about, 'hobbies') && <p class="about__hobbies">{L(about, 'hobbies')}</p>}
    </div>
  </section>

  {
    about.experience.length > 0 && (
      <section class="container block">
        <div class="block__head">
          <h2>{tx.experience}</h2>
          {resume && (
            <a class="link-arrow" href={resume} target="_blank" rel="noopener">
              {tx.fullResume}
            </a>
          )}
        </div>
        <ol class="timeline">
          {about.experience.map((e) => (
            <li data-reveal="fade">
              <span class="label">{L(e, 'period')}</span>
              <div>
                <h3>{L(e, 'company')}</h3>
                <p class="timeline__role">{L(e, 'role')}</p>
                {L(e, 'text') && <p class="timeline__text">{L(e, 'text')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    kit.length > 0 && (
      <section class="container block block--last">
        <div class="block__head">
          <h2>{tx.kit}</h2>
        </div>
        <div class="kit">
          {kit.map((g) => (
            <div class="kit__group">
              <p class="kit__label label">{g.label}</p>
              <ul class="kit__rows">
                {g.rows.map((r) => (
                  <li class="kit__row" data-reveal="fade">
                    <h3>{r.title}</h3>
                    <p>{r.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .about {
    padding-top: clamp(40px, 6vw, 88px);
  }
  .about__label {
    margin-bottom: 16px;
  }
  .back {
    display: inline-block;
    margin-bottom: clamp(28px, 4vw, 56px);
    padding: 8px 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    color: var(--muted);
  }
  .about__headline {
    max-width: 900px;
    font-size: clamp(32px, 4vw, 56px);
    letter-spacing: -0.035em;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(32px, 5vw, 72px);
  }
  .about__text {
    grid-column: 1 / 6;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.55;
  }
  .about__photos {
    grid-column: 7 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .ph:hover :global(img) {
    filter: none;
  }
  .ph--0 {
    grid-row: span 2;
    aspect-ratio: 3 / 4;
  }
  .ph--1,
  .ph--2 {
    aspect-ratio: 4 / 3;
  }
  .about__hobbies {
    grid-column: 7 / 13;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .block {
    padding-top: clamp(64px, 9vw, 128px);
  }
  .block--last {
    padding-bottom: clamp(64px, 9vw, 128px);
  }

  /* Навыки и инструменты: таблица на 12 колонках — раздел слева (до 6-й колонки), строки справа */
  .kit {
    border-top: 1px solid var(--ink);
  }
  .kit__group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    border-bottom: 1px solid var(--line);
  }
  /* подпись раздела едет вместе со строками, пока раздел на экране */
  .kit__label {
    grid-column: 1 / 6;
    align-self: start;
    position: sticky;
    top: 24px;
    padding-top: clamp(18px, 1.8vw, 24px);
  }
  .kit__rows {
    grid-column: 6 / 13;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kit__row {
    display: grid;
    gap: 6px;
    padding-block: clamp(18px, 1.8vw, 24px);
  }
  .kit__row + .kit__row {
    border-top: 1px solid var(--line);
  }
  .kit__row h3 {
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.2;
  }
  .kit__row p {
    color: var(--muted);
    max-width: 620px;
  }
  @media (max-width: 900px) {
    .kit__label,
    .kit__rows {
      grid-column: 1 / -1;
    }
    .kit__label {
      position: static;
      padding-bottom: 4px;
    }
  }

  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .block h2 {
    font-size: var(--fs-h2);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .timeline li > .label {
    grid-column: 1 / 6;
    font-size: 15px;
    padding-top: 6px;
  }
  .timeline li > div {
    grid-column: 6 / 13;
  }
  .timeline h3 {
    font-size: var(--fs-h3);
  }
  .timeline__role {
    margin-top: 6px;
    font-weight: 600;
  }
  .timeline__text {
    margin-top: 10px;
    color: var(--muted);
    max-width: 680px;
  }


















  @media (max-width: 900px) {
    .about__text,
    .about__photos,
    .about__hobbies {
      grid-column: 1 / -1;
    }
  
  
    .timeline li > .label,
    .timeline li > div {
      grid-column: 1 / -1;
    }
    .timeline li {
      row-gap: 4px;
    }
  }
  @media (max-width: 560px) {
    .block__head {
      flex-direction: column;
    }
  }
</style>
