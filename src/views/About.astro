---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAbout, getSettings, richText, resumeHref } from '../lib/content';
import Stack from '../components/Stack.astro';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const about = await getAbout();
const s = await getSettings();
const resume = resumeHref(s, lang);
---

<Base title={tx.aboutTitle} description={L(about, 'text')} lang={lang}>
  <section class="container about">
    <a class="back" href={href(lang, '/')}>{tx.backHome}</a>
    <p class="about__label label" data-reveal="fade">{tx.aboutLabel}</p>
    <h1 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h1>

    <div class="about__grid">
      <div class="rich about__text" set:html={richText(L(about, 'text'))} />
      <div class="about__photos">
        {
          about.photos.map(
            (p, i) =>
              p && (
                <figure class:list={['ph', `ph--${i}`]}>
                  <Image src={p} alt="" widths={[360, 720]} sizes="(max-width: 720px) 50vw, 25vw" loading={i < 2 ? 'eager' : 'lazy'} />
                </figure>
              )
          )
        }
      </div>
      {L(about, 'hobbies') && <p class="about__hobbies">{L(about, 'hobbies')}</p>}
    </div>
  </section>

  {
    about.experience.length > 0 && (
      <section class="container block">
        <div class="block__head">
          <h2>{tx.experience}</h2>
          {resume && (
            <a class="link-arrow" href={resume} target="_blank" rel="noopener">
              {tx.fullResume}
            </a>
          )}
        </div>
        <ol class="timeline">
          {about.experience.map((e) => (
            <li data-reveal="fade">
              <span class="label">{L(e, 'period')}</span>
              <div>
                <h3>{L(e, 'company')}</h3>
                <p class="timeline__role">{L(e, 'role')}</p>
                {L(e, 'text') && <p class="timeline__text">{L(e, 'text')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    about.skills.length > 0 && (
      <section class="container block">
        <div class="block__head">
          <h2>{tx.skills}</h2>
        </div>
        <ol class="skills">
          {about.skills.map((g, i) => (
            <li class="skills__group" data-reveal="fade">
              <span class="skills__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{L(g, 'title')}</h3>
              <ul>
                {L(g, 'items').split('\n').filter(Boolean).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <div class="block block--stack">
    <Stack lang={lang} />
  </div>

  {
    about.softSkills.length > 0 && (
      <section class="container block block--last">
        <div class="block__head">
          <h2>{tx.softSkills}</h2>
        </div>
        <ol class="soft">
          {about.softSkills.map((item, i) => (
            <li class="soft__row" data-reveal="fade">
              <span class="skills__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{L(item, 'title')}</h3>
              <p>{L(item, 'text')}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .about {
    padding-top: clamp(40px, 6vw, 88px);
  }
  .about__label {
    margin-bottom: 16px;
  }
  .back {
    display: inline-block;
    margin-bottom: clamp(28px, 4vw, 56px);
    padding: 8px 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    color: var(--muted);
  }
  .about__headline {
    max-width: 900px;
    font-size: clamp(32px, 4vw, 56px);
    letter-spacing: -0.035em;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(32px, 5vw, 72px);
  }
  .about__text {
    grid-column: 1 / 6;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.55;
  }
  .about__photos {
    grid-column: 7 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .ph:hover :global(img) {
    filter: none;
  }
  .ph--0 {
    grid-row: span 2;
    aspect-ratio: 3 / 4;
  }
  .ph--1,
  .ph--2 {
    aspect-ratio: 4 / 3;
  }
  .about__hobbies {
    grid-column: 7 / 13;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .block {
    padding-top: clamp(64px, 9vw, 128px);
  }
  .block--last {
    padding-bottom: clamp(64px, 9vw, 128px);
  }
  /* стек на этой странице — тот же компонент, что на главной */
  .block--stack :global(.stack) {
    padding-bottom: 0;
  }

  /* навыки: четыре колонки с номерами и списками через тонкие линии */
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .skills__group {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .skills__num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .skills__group h3 {
    font-size: clamp(20px, 1.7vw, 24px);
    margin-bottom: 6px;
  }
  .skills__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills__group ul li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* soft-скиллы: строки с номером, крупным названием и описанием */
  .soft {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .soft__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--gap);
    align-items: baseline;
    padding-block: clamp(18px, 2vw, 28px);
    border-top: 1px solid var(--line);
  }
  .soft__row h3 {
    font-size: clamp(22px, 2.2vw, 32px);
  }
  .soft__row p {
    color: var(--muted);
    max-width: 560px;
  }
  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .block h2 {
    font-size: var(--fs-h2);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .timeline li > .label {
    grid-column: 1 / 4;
    font-size: 15px;
    padding-top: 6px;
  }
  .timeline li > div {
    grid-column: 4 / 11;
  }
  .timeline h3 {
    font-size: var(--fs-h3);
  }
  .timeline__role {
    margin-top: 6px;
    font-weight: 600;
  }
  .timeline__text {
    margin-top: 10px;
    color: var(--muted);
    max-width: 680px;
  }


















  @media (max-width: 1024px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 900px) {
    .about__text,
    .about__photos,
    .about__hobbies {
      grid-column: 1 / -1;
    }
  
  
    .timeline li > .label,
    .timeline li > div {
      grid-column: 1 / -1;
    }
    .timeline li {
      row-gap: 4px;
    }
  }
  @media (max-width: 560px) {
    .skills {
      grid-template-columns: 1fr;
    }
    .soft__row {
      grid-template-columns: 36px minmax(0, 1fr);
    }
    .soft__row p {
      grid-column: 2;
    }
  
    .block__head {
      flex-direction: column;
    }
  }
</style>
