---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAbout, getSettings, richText, resumeHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const about = await getAbout();
const s = await getSettings();
const resume = resumeHref(s, lang);

// Навыки, инструменты и софт-скиллы — один блок из трёх разделов карточек разного цвета:
// навыки — белые со списком, инструменты — тёмные с тегами, софт-скиллы — светло-зелёные с текстом
const lines = (v: string) => v.split('\n').map((x) => x.trim()).filter(Boolean);
const tags = (v: string) => v.split(',').map((x) => x.trim()).filter(Boolean);
const kitSkills = about.skills.map((g) => ({ title: L(g, 'title'), items: lines(L(g, 'items')) }));
const kitTools = [
  ...about.tools.map((g) => ({ title: L(g, 'name'), tags: tags(L(g, 'details')) })),
  ...(L(about, 'languages') ? [{ title: tx.languages, tags: [L(about, 'languages')] }] : []),
];
const kitSoft = about.softSkills.map((g) => ({ title: L(g, 'title'), text: L(g, 'text') }));
---

<Base title={tx.aboutTitle} description={L(about, 'text')} lang={lang}>
  <section class="container about">
    <a class="back" href={href(lang, '/')}>{tx.backHome}</a>
    <p class="about__label label" data-reveal="fade">{tx.aboutLabel}</p>
    <h1 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h1>

    <div class="about__grid">
      <div class="rich about__text" set:html={richText(L(about, 'text'))} />
      <div class="about__photos">
        {
          about.photos.map(
            (p, i) =>
              p && (
                <figure class:list={['ph', `ph--${i}`]}>
                  <Image src={p} alt="" widths={[360, 720]} sizes="(max-width: 720px) 50vw, 25vw" loading={i < 2 ? 'eager' : 'lazy'} />
                </figure>
              )
          )
        }
      </div>
      {L(about, 'hobbies') && <p class="about__hobbies">{L(about, 'hobbies')}</p>}
    </div>
  </section>

  {
    about.experience.length > 0 && (
      <section class="container block">
        <div class="block__head">
          <h2>{tx.experience}</h2>
          {resume && (
            <a class="link-arrow" href={resume} target="_blank" rel="noopener">
              {tx.fullResume}
            </a>
          )}
        </div>
        <ol class="timeline">
          {about.experience.map((e) => (
            <li data-reveal="fade">
              <span class="label">{L(e, 'period')}</span>
              <div>
                <h3>{L(e, 'company')}</h3>
                <p class="timeline__role">{L(e, 'role')}</p>
                {L(e, 'text') && <p class="timeline__text">{L(e, 'text')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="container block block--last">
    <div class="block__head">
      <h2>{tx.kit}</h2>
    </div>

    {kitSkills.length > 0 && (
      <div class="kit">
        <p class="kit__label label">{tx.skills}</p>
        <ul class="kit__grid kit__grid--skills">
          {kitSkills.map((c) => (
            <li class="card card--light" data-reveal="fade">
              <h3>{c.title}</h3>
              <ul class="card__list">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    )}

    {kitTools.length > 0 && (
      <div class="kit">
        <p class="kit__label label">{tx.tools}</p>
        <ul class="kit__grid kit__grid--tools">
          {kitTools.map((c) => (
            <li class="card card--dark" data-reveal="fade">
              <h3>{c.title}</h3>
              <ul class="card__tags">
                {c.tags.map((t) => <li>{t}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    )}

    {kitSoft.length > 0 && (
      <div class="kit">
        <p class="kit__label label">{tx.softSkills}</p>
        <ul class="kit__grid kit__grid--soft">
          {kitSoft.map((c) => (
            <li class="card card--green" data-reveal="fade">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>

<style>
  .about {
    padding-top: clamp(40px, 6vw, 88px);
  }
  .about__label {
    margin-bottom: 16px;
  }
  .back {
    display: inline-block;
    margin-bottom: clamp(28px, 4vw, 56px);
    padding: 8px 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    color: var(--muted);
  }
  .about__headline {
    max-width: 900px;
    font-size: clamp(32px, 4vw, 56px);
    letter-spacing: -0.035em;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(32px, 5vw, 72px);
  }
  .about__text {
    grid-column: 1 / 6;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.55;
  }
  .about__photos {
    grid-column: 7 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .ph:hover :global(img) {
    filter: none;
  }
  .ph--0 {
    grid-row: span 2;
    aspect-ratio: 3 / 4;
  }
  .ph--1,
  .ph--2 {
    aspect-ratio: 4 / 3;
  }
  .about__hobbies {
    grid-column: 7 / 13;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .block {
    padding-top: clamp(64px, 9vw, 128px);
  }
  .block--last {
    padding-bottom: clamp(64px, 9vw, 128px);
  }

  /* Навыки и инструменты: карточки со скруглением, без линий. Три раздела — три цвета */
  .kit + .kit {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .kit__label {
    margin-bottom: 16px;
  }
  .kit__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap);
  }
  .kit__grid--skills {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* инструменты: по 3 в ряд, а неполный последний ряд растягивается на всю ширину — без дыр */
  .kit__grid--tools {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .kit__grid--tools > li {
    grid-column: span 2;
  }
  .kit__grid--tools > li:nth-child(3n + 1):nth-last-child(2),
  .kit__grid--tools > li:nth-child(3n + 1):nth-last-child(2) ~ li {
    grid-column: span 3;
  }
  .kit__grid--tools > li:nth-child(3n + 1):last-child {
    grid-column: span 6;
  }
  /* софт-скиллы делят ширину поровну, сколько бы их ни было */
  .kit__grid--soft {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(22px, 2.2vw, 32px);
    border-radius: var(--radius);
  }
  .card h3 {
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.2;
  }
  .card--light {
    background: var(--card);
  }
  .card--dark {
    background: var(--ink);
    color: var(--paper);
  }
  .card--green {
    background: color-mix(in srgb, var(--accent) 16%, var(--paper));
  }
  .card--green p {
    color: color-mix(in srgb, var(--ink) 75%, transparent);
  }
  .card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }
  .card__list li {
    position: relative;
    padding-left: 18px;
  }
  .card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .card__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .card__tags li {
    padding: 7px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: #bfe8cd;
    font-size: 14px;
    line-height: 1.2;
  }
  @media (max-width: 1024px) {
    .kit__grid--skills,
    .kit__grid--tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kit__grid--tools > li,
    .kit__grid--tools > li:nth-child(3n + 1):nth-last-child(2),
    .kit__grid--tools > li:nth-child(3n + 1):nth-last-child(2) ~ li,
    .kit__grid--tools > li:nth-child(3n + 1):last-child {
      grid-column: auto;
    }
    .kit__grid--tools > li:nth-child(odd):last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .kit__grid--skills,
    .kit__grid--tools {
      grid-template-columns: 1fr;
    }
  }

  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .block h2 {
    font-size: var(--fs-h2);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .timeline li > .label {
    grid-column: 1 / 6;
    font-size: 15px;
    padding-top: 6px;
  }
  .timeline li > div {
    grid-column: 6 / 13;
  }
  .timeline h3 {
    font-size: var(--fs-h3);
  }
  .timeline__role {
    margin-top: 6px;
    font-weight: 600;
  }
  .timeline__text {
    margin-top: 10px;
    color: var(--muted);
    max-width: 680px;
  }


















  @media (max-width: 900px) {
    .about__text,
    .about__photos,
    .about__hobbies {
      grid-column: 1 / -1;
    }
  
  
    .timeline li > .label,
    .timeline li > div {
      grid-column: 1 / -1;
    }
    .timeline li {
      row-gap: 4px;
    }
  }
  @media (max-width: 560px) {
    .block__head {
      flex-direction: column;
    }
  }
</style>
