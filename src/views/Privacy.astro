---
import Base from '../layouts/Base.astro';
import { getPrivacy, richText } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = await getPrivacy();
const title = loc(p, 'title', lang);
---

<Base title={title} lang={lang}>
  <article class="container privacy">
    <a class="back" href={href(lang, '/')}><svg class="back__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3 5.5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>{t(lang).backHome}</a>
    <h1>{title}</h1>
    <div class="rich privacy__text" set:html={richText(loc(p, 'text', lang))} />
  </article>
</Base>

<style>
  .privacy {
    padding-block: clamp(24px, 3vw, 40px) clamp(64px, 9vw, 128px);
  }
  /* «На главную» — как на странице «Обо мне» */
  .back {
    margin-bottom: clamp(20px, 2.4vw, 32px);
    padding: 8px 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  .privacy h1 {
    margin-top: 0;
  }
  .privacy h1 {
    max-width: 900px;
    font-size: clamp(36px, 5vw, 72px);
    letter-spacing: -0.035em;
  }
  .privacy__text {
    max-width: 760px;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: 16px;
    line-height: 1.6;
  }
  .privacy__text :global(h2) {
    margin: 2.2em 0 0.8em;
    font-size: clamp(20px, 1.8vw, 24px);
  }
  .privacy__text :global(h2:first-child) {
    margin-top: 0;
  }
</style>
