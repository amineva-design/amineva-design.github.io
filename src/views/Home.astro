---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Stack from '../components/Stack.astro';
import Line from '../components/Line.astro';
import AsciiPortrait from '../components/AsciiPortrait.astro';
import MatrixRain from '../components/MatrixRain.astro';
import portraitAscii from '../assets/site/portrait-ascii.png';
import { getSettings, getAbout, getCases, inline } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const s = await getSettings();
const about = await getAbout();
const cases = await getCases();
const name = L(s, 'name');
const role = L(s, 'role');
const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ');
const greeting = [...(L(s, 'greeting') || (lang === 'en' ? 'Hi!' : 'Привет!'))];
---

<Base theme="dark" lang={lang}>
  <section class="hero dark">
    <MatrixRain />
    <div class="hero__ascii">
      <AsciiPortrait src={portraitAscii} alt={name} />
    </div>
    <div class="container hero__grid">
      <h1 class="visually-hidden">{name} — {role}</h1>

      <p class="hero__greeting" aria-hidden="true" data-reveal="fade">
        {greeting.map((ch) => <span class="g">{ch === ' ' ? '\u00a0' : ch}</span>)}
      </p>

      <div class="hero__name">
        <p class="hero__note caps" data-reveal="fade">
          <Line name="oval" class="hero__oval" />
          {tx.heroNote[0]}<br />{tx.heroNote[1]}
        </p>
        <p class="hero__fullname" aria-hidden="true" data-reveal="lines">{firstName}<br />{lastName}</p>
        <p class="hero__role caps">{role}</p>
      </div>

      <div class="hero__intro">
        <p class="caps" data-reveal="lines">{L(s, 'intro')}</p>
      </div>

      <p class="hero__location caps" data-reveal="fade" set:html={inline(L(s, 'location'))} />
    </div>
  </section>

  <section class="cases" id="cases">
    <div class="container">
      <h2 class="section-title" data-reveal="fade">{tx.casesTitle} <sup>{String(cases.length).padStart(2, '0')}</sup></h2>
      <div class="cases__list">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} lang={lang} />)}
      </div>
    </div>
  </section>

  <Stack lang={lang} />

  <section class="about-teaser">
    <div class="container about">
      <p class="about__label" data-reveal="fade">{tx.aboutLabel}</p>
      <div class="about__head">
        <h2 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h2>
        <a class="btn btn--ghost about__more" href={href(lang, '/about')}>{tx.aboutMore}</a>
      </div>

      {about.photos[0] && (
        <figure class="about__ph about__ph--portrait">
          <Image src={about.photos[0]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}

      <Line name="curve" class="about__curve" />

      <div class="about__text">
        <p class="caps" data-reveal="lines">{L(about, 'text')}</p>
      </div>

      {about.photos[1] && (
        <figure class="about__book">
          <div class="about__ph about__ph--book">
            <Image src={about.photos[1]} alt="" widths={[320, 640]} sizes="(max-width: 900px) 45vw, 16vw" loading="lazy" />
          </div>
          {L(about, 'hobbies') && <figcaption class="about__hobbies caps">{L(about, 'hobbies')}</figcaption>}
        </figure>
      )}

      {about.photos[2] && (
        <figure class="about__ph about__ph--plane">
          <Image src={about.photos[2]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}
    </div>
  </section>
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-top: -1px;
  }
  /* ASCII-портрет по центру первого экрана, под текстами */
  .hero__ascii {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: 0;
    width: min(38vw, 560px);
    height: 92%;
    transform: translateX(-50%);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    min-height: min(calc(100svh - 65px - clamp(32px, 4vw, 56px)), 940px);
    grid-template-rows: auto auto 1fr auto;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(24px, 3vw, 40px);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .hero__greeting {
    grid-column: 1 / 8;
    font-family: var(--display);
    font-size: clamp(56px, 8.4vw, 132px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    user-select: none;
  }
  .g {
    display: inline-block;
    font-variation-settings: 'wght' 700;
    transition: font-variation-settings 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .g:hover {
    font-variation-settings: 'wght' 400;
    transform: translateY(-0.04em);
  }
  .hero__name {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .hero__note {
    position: relative;
    margin: clamp(8px, 2vw, 32px) clamp(40px, 8vw, 140px) clamp(16px, 2vw, 28px) 0;
    padding: 18px 26px 22px;
    text-align: left;
  }
  .hero__note :global(.hero__oval) {
    position: absolute;
    inset: -6px -14px -14px -18px;
    width: calc(100% + 32px);
    height: calc(100% + 20px);
  }
  .hero__fullname {
    font-family: var(--display);
    font-size: clamp(56px, 8.4vw, 132px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  /* роль в hero показываем только на телефоне — на десктопе она в шапке */
  .hero__role {
    display: none;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .hero__photo {
    position: relative;
    margin: 0;
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .hero__photo:hover :global(img) {
    filter: grayscale(0);
  }




  .hero__intro {
    grid-column: 1 / 4;
    grid-row: 3;
    align-self: center;
    display: grid;
    gap: 14px;
    max-width: 420px;
  }
  .hero__intro p {
    font-size: var(--fs-caps);
    line-height: 1.35;
  }



  /* «Выйди за рамки»: подпись начинается на фото и вылезает за сетку до края экрана */


  .hero__location {
    grid-column: 8 / 13;
    grid-row: 4;
    align-self: end;
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 900px) {
    .hero__greeting,
    .hero__note {
      display: none;
    }
    .hero__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .hero__greeting {
      grid-column: 1 / -1;
    }
    .hero__name {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hero__role {
      display: inline-flex;
    }
    .hero__intro {
      grid-column: 1 / -1;
      grid-row: auto;
      max-width: none;
    }
  

    .hero {
      display: flex;
      flex-direction: column;
    }
    .hero__grid {
      min-height: 0;
      grid-template-rows: none;
    }
    .hero__ascii {
      position: relative;
      order: 2;
      left: auto;
      width: 100%;
      height: 108vw;
      transform: none;
      margin-top: 8px;
    }
    .hero__location {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  @media (max-width: 560px) {
    .hero__note {
      margin-right: 8px;
    }
    .hero__intro {
      grid-column: 1 / -1;
    }
  }

  /* ——— Кейсы ——— */
  .cases {
    padding-block: clamp(56px, 8vw, 112px);
  }
  .section-title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .section-title sup {
    font-size: 0.4em;
    vertical-align: top;
    margin-left: 4px;
    color: var(--muted);
    font-weight: 500;
  }
  .cases__list {
    display: grid;
    gap: clamp(32px, 3vw, 40px);
  }

  /* ——— Обо мне: свободная композиция, как на прежнем сайте ——— */
  .about-teaser {
    padding-bottom: clamp(72px, 10vw, 144px);
  }
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto 1fr;
    column-gap: var(--gap);
  }
  .about__label {
    grid-column: 1 / 8;
    grid-row: 1;
    font-family: var(--display);
    font-size: var(--fs-h3);
    color: var(--accent);
    margin-bottom: clamp(20px, 2.4vw, 36px);
  }
  .about__head {
    grid-column: 1 / 8;
    grid-row: 2;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .about__more {
    font-size: 14px;
  }
  .about__more:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .about__headline {
    font-size: clamp(30px, 3vw, 44px);
    max-width: 720px;
  }
  .about__ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .about__ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .about__ph:hover :global(img) {
    filter: none;
  }
  .about__ph--portrait {
    grid-column: 1 / 4;
    grid-row: 3 / 5;
    align-self: start;
    margin-top: clamp(24px, 3.4vw, 48px);
    aspect-ratio: 6 / 5;
  }
  .about :global(.about__curve) {
    grid-column: 4 / 8;
    grid-row: 3;
    align-self: start;
    width: 100%;
    height: auto;
    aspect-ratio: 220 / 127;
    margin-top: -36px;
    transform: scaleX(-1);
  }
  .about__text {
    grid-column: 4 / 8;
    grid-row: 4;
    align-self: end;
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 420px;
  }
  .about__text p {
    line-height: 1.35;
  }
  .about__text .link-arrow {
    font-size: 12px;
  }
  .about__book {
    grid-column: 8 / 10;
    grid-row: 2 / 5;
    align-self: start;
    margin: 8px 0 0;
  }
  .about__ph--book {
    aspect-ratio: 7 / 5;
  }
  .about__hobbies {
    margin-top: 16px;
    font-size: 11px;
    text-align: right;
  }
  .about__ph--plane {
    grid-column: 10 / 13;
    grid-row: 2 / 5;
    align-self: start;
    margin-top: 8px;
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: none;
      row-gap: 24px;
    }
    .about__label,
    .about__head {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .about__label {
      margin-bottom: 0;
    }
    /* как на прежнем сайте: фото слева + текст справа, книга справа + подпись слева, без самолёта */
    .about__ph--portrait {
      grid-column: 1 / 4;
      grid-row: 3;
      margin-top: 8px;
      aspect-ratio: 4 / 5;
    }
    .about__text {
      grid-column: 4 / 7;
      grid-row: 3;
      align-self: end;
      max-width: none;
    }
    .about__text p {
      font-size: 12px;
    }
    .about :global(.about__curve) {
      grid-column: 1 / 5;
      grid-row: 4;
      margin-top: -40px;
      margin-bottom: -60px;
      z-index: 1;
    }
    .about__book {
      grid-column: 1 / -1;
      grid-row: 5;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap);
      margin-top: 0;
    }
    .about__ph--book {
      grid-column: 2;
      grid-row: 1;
    }
    .about__hobbies {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      margin-top: 0;
      text-align: right;
    }
    .about__ph--plane {
      display: none;
    }
  }
</style>
