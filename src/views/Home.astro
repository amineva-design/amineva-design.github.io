---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ActionButton from '../components/ActionButton.astro';
import Stack from '../components/Stack.astro';
import AsciiPortrait from '../components/AsciiPortrait.astro';
import Typewriter from '../components/Typewriter.astro';
import MatrixRain from '../components/MatrixRain.astro';
import portraitAscii from '../assets/site/portrait-ascii.png';
import portraitAsciiStill from '../assets/site/portrait-ascii-fallback.png';
import { getSettings, getAbout, getCases, inline } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const s = await getSettings();
const about = await getAbout();
const cases = await getCases();
const name = L(s, 'name');
// «Живу ~~за ноутбуком~~ в Москве» → префикс и две печатающиеся фразы
const locMatch = L(s, 'location').match(/^(.*?)\s*~~(.+?)~~\s*(.*)$/);
const locPrefix = locMatch ? locMatch[1] : L(s, 'location');
const locPhrases = locMatch ? [locMatch[2], locMatch[3]].filter(Boolean) : [''];
const role = L(s, 'role');
// на телефоне роль в две строки: «Продуктовый / UX/UI дизайнер»
const [roleFirst, ...roleRest] = role.split(' ');
const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ');
---

<Base theme="dark" lang={lang}>
  <section class="hero dark">
    <MatrixRain />
    <div class="hero__ascii">
      <AsciiPortrait src={portraitAscii} alt={name} align="right" fallback={portraitAsciiStill} />
    </div>
    <div class="container hero__grid">
      <h1 class="visually-hidden">{name} — {role}</h1>

      <div class="hero__name">
        <p class="hero__code caps" aria-hidden="true" data-reveal="fade"><span class="hero__prompt">&gt;</span> {tx.heroCode}<span class="hero__caret"></span></p>
        <p class="hero__fullname" aria-hidden="true" data-reveal="lines">{firstName}<br />{lastName}</p>
        <p class="hero__role caps">{roleFirst}<br />{roleRest.join(' ')}</p>
      </div>

      <div class="hero__intro">
        <p class="caps" data-reveal="lines">{L(s, 'intro')}</p>
      </div>

      <div class="hero__location caps"><Typewriter prefix={locPrefix} phrases={locPhrases} /></div>
    </div>
  </section>

  <section class="cases" id="cases">
    <div class="container">
      <h2 class="section-title" data-reveal="fade">{tx.casesTitle}</h2>
      <div class="cases__list">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} lang={lang} />)}
      </div>
    </div>
  </section>

  <Stack lang={lang} />

  <section class="about-teaser">
    <div class="container about">
      <h2 class="about__label section-title" data-reveal="fade">{tx.aboutLabel}</h2>
      <div class="about__head">
        <p class="about__headline" data-reveal="lines">{L(about, 'text')}</p>
        {L(about, 'hobbies') && <p class="about__hobbies about__hobbies--desk" data-reveal="fade">{L(about, 'hobbies')}</p>}
        <ActionButton class="about__more" href={href(lang, '/about')} label={tx.aboutMore} />
      </div>
      <div class="about__photos">
        {about.photos.slice(0, 2).map((p) => p && (
          <figure class="about__ph" data-reveal="img">
            <Image src={p} alt="" widths={[400, 800]} sizes="(max-width: 900px) 45vw, 22vw" loading="lazy" />
          </figure>
        ))}
      </div>
      {L(about, 'hobbies') && <p class="about__hobbies about__hobbies--mob">{L(about, 'hobbies')}</p>}
    </div>
  </section>
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-top: -1px;
  }
  /* ASCII-портрет — акцент справа, прижат к правому краю сетки; весь текст слева */
  .hero__ascii {
    position: absolute;
    z-index: 0;
    right: max(0px, calc((100vw - var(--max)) / 2));
    bottom: 0;
    width: min(60vw, 900px);
    height: 90%;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    min-height: min(calc(100svh - 65px - clamp(32px, 4vw, 56px)), 940px);
    grid-template-rows: auto auto 1fr;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(24px, 3vw, 40px);
    padding-top: clamp(32px, 4vw, 56px);
  }
  /* Слева сверху вниз: строка «в коде» → имя → описание */
  .hero__name {
    grid-column: 1 / 7;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__code {
    margin: 0 0 clamp(16px, 2vw, 28px);
    color: var(--accent);
  }
  .hero__prompt {
    margin-right: 0.35em;
  }
  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 2px;
    margin-left: 4px;
    vertical-align: baseline;
    background: currentColor;
    animation: hero-blink 1s steps(1) infinite;
  }
  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  .hero__fullname {
    font-family: var(--display);
    font-size: clamp(56px, 8.4vw, 132px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  /* роль в hero показываем только на телефоне — на десктопе она в шапке */
  .hero__role {
    display: none;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .hero__photo {
    position: relative;
    margin: 0;
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .hero__photo:hover :global(img) {
    filter: grayscale(0);
  }




  .hero__intro {
    grid-column: 1 / 5;
    grid-row: 2;
    align-self: start;
    display: grid;
    gap: 14px;
    max-width: 420px;
  }
  .hero__intro p {
    font-size: var(--fs-caps);
    line-height: 1.6;
  }





  /* «Живу за ноутбуком» — зелёная печатающаяся строка, как «Привет! Давай знакомиться» */
  .hero__location {
    grid-column: 1 / 6;
    grid-row: 3;
    align-self: end;
    color: var(--accent);
  }

  /* Телефон и планшет: всё в одну колонку — имя, портрет, описание, город. Ничего не наезжает */
  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      padding-top: 40px;
    }
    .hero__grid {
      display: contents;
    }
    .hero__code {
      margin-bottom: 14px;
    }
    .hero__name,
    .hero__intro,
    .hero__location {
      position: relative;
      z-index: 1;
      padding-inline: var(--gutter);
    }
    /* первый экран — как обложка: имя и роль сверху, под ними портрет до низа экрана.
       Описание и город — уже при прокрутке */
    .hero__name {
      order: 1;
      align-items: flex-start;
    }
    .hero__fullname {
      font-size: 12.5vw;
    }
    .hero__role {
      display: block;
      line-height: 1.35;
      margin-top: 10px;
    }
    .hero {
      /* высота экрана минус шапка, отступ сверху и блок с именем (2 строки имени + 2 строки роли) */
      /* экран минус шапка, отступ, строка кода, имя с ролью — и ещё немного, чтобы описание подтянулось выше */
      --ascii-h: max(92vw, calc(100svh - 65px - 40px - 32px - 23.75vw - 56px - 110px));
    }
    .hero__ascii {
      order: 2;
      position: relative;
      right: auto;
      bottom: auto;
      width: 100%;
      height: var(--ascii-h);
      margin-top: 8px;
    }
    .hero__intro {
      order: 3;
      max-width: 520px;
      margin-top: 20px;
    }
    .hero__intro p {
      font-size: 12px;
      line-height: 1.65;
    }
    .hero__location {
      order: 4;
      align-self: flex-start;
      margin-top: 20px;
    }
  }


  /* ——— Кейсы ——— */
  .cases {
    padding-block: clamp(56px, 8vw, 112px);
  }
  .section-title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  /* кейсы — по два в ряд: квадратная обложка, под ней коротко о проекте */
  .cases__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(32px, 4vw, 56px);
  }
  @media (max-width: 640px) {
    .cases__list {
      grid-template-columns: 1fr;
    }
  }

  /* ——— Обо мне: текст слева, две фотографии одной высоты справа ——— */
  .about-teaser {
    padding-bottom: clamp(72px, 10vw, 144px);
  }
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
  }
  .about__label {
    grid-column: 1 / -1;
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .about__head {
    grid-column: 1 / 5;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .about__headline {
    font-family: var(--display);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .about__hobbies {
    color: var(--muted);
    max-width: 420px;
    margin: 0;
  }
  .about__more {
    margin-top: 8px;
  }
  .about__photos {
    grid-column: 6 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .about__ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
    background: #e4e4e2;
  }
  .about__ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* «Помимо дизайна люблю…» — на десктопе в тексте слева, на телефоне под фотографиями */
  .about__hobbies--mob {
    display: none;
  }
  @media (max-width: 900px) {
    .about__hobbies--desk {
      display: none;
    }
    .about__hobbies--mob {
      display: block;
      grid-column: 1 / -1;
      margin-top: 16px;
    }
    .about__head,
    .about__photos {
      grid-column: 1 / -1;
    }
    .about__photos {
      margin-top: 24px;
    }
    /* на телефоне фраза плотнее: меньше кегль и межстрочный, строки заполняют ширину */
    .about__head {
      gap: 16px;
    }
    .about__headline {
      font-size: 20px;
      line-height: 1.25;
      text-wrap: wrap;
    }
  }
</style>
