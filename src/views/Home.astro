---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Stack from '../components/Stack.astro';
import Line from '../components/Line.astro';
import Scribbles from '../components/Scribbles.astro';
import Badge from '../components/Badge.astro';
import Facts from '../components/Facts.astro';
import { getSettings, getAbout, getCases, inline } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const s = await getSettings();
const about = await getAbout();
const cases = await getCases();
const name = L(s, 'name');
const role = L(s, 'role');
const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ');
---

<Base theme="dark" lang={lang}>
  <section class="hero dark">
    <div class="container hero__stage">
      <p class="hero__note caps" data-reveal="fade">
        <Line name="oval" class="hero__oval" />
        {tx.heroNote[0]}<br />{tx.heroNote[1]}
      </p>

      <h1 class="hero__name">
        <span class="hero__first" data-reveal="fade">{firstName}</span>
        <span class="hero__last" data-reveal="fade">{lastName}</span>
        <span class="visually-hidden"> — {role}</span>
      </h1>

      {
        s.portrait && (
          <figure class="hero__portrait" data-reveal="fade">
            <Image src={s.portrait} alt={name} widths={[480, 800, 1200]} sizes="(max-width: 900px) 80vw, 40vw" loading="eager" fetchpriority="high" />
            <Scribbles />
          </figure>
        )
      }

      {s.openToWork && <Badge text={tx.badge} class="hero__badge" />}

      <p class="hero__intro caps" data-reveal="lines">{L(s, 'intro')}</p>
      <p class="hero__escape caps" data-reveal="fade">{tx.photoFrames[0]}<br />{tx.photoFrames[1]}</p>
    </div>
  </section>

  <Facts lang={lang} />

  <section class="cases" id="cases">
    <div class="container">
      <h2 class="section-title" data-reveal="fade">{tx.casesTitle} <sup>{String(cases.length).padStart(2, '0')}</sup></h2>
      <div class="cases__list">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} lang={lang} />)}
      </div>
    </div>
  </section>

  <Stack lang={lang} />

  <section class="about-teaser">
    <div class="container about">
      <p class="about__label" data-reveal="fade">{tx.aboutLabel}</p>
      <h2 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h2>

      {about.photos[0] && (
        <figure class="about__ph about__ph--portrait" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: -2deg">
          <Image src={about.photos[0]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}

      <Line name="curve" class="about__curve" />

      <div class="about__text">
        <p class="caps" data-reveal="lines">{L(about, 'text')}</p>
        <a class="link-arrow caps" href={href(lang, '/about')}>{tx.aboutMore}</a>
      </div>

      {about.photos[1] && (
        <figure class="about__book">
          <div class="about__ph about__ph--book" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: 3deg">
            <Image src={about.photos[1]} alt="" widths={[320, 640]} sizes="(max-width: 900px) 45vw, 16vw" loading="lazy" />
          </div>
          {L(about, 'hobbies') && <figcaption class="about__hobbies caps">{L(about, 'hobbies')}</figcaption>}
        </figure>
      )}

      {about.photos[2] && (
        <figure class="about__ph about__ph--plane" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: -1.5deg">
          <Image src={about.photos[2]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}
    </div>
  </section>
</Base>

<style>
  /* ——— Hero: огромное имя, портрет без фона поверх букв, каракули и бейдж ——— */
  .hero {
    overflow: hidden;
  }
  .hero__stage {
    position: relative;
    min-height: min(calc(100svh - 65px), 960px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(48px, 6vw, 88px) clamp(96px, 12vw, 160px);
  }
  .hero__name {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    font-family: var(--display);
    font-size: clamp(64px, 15.5vw, 280px);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .hero__name span {
    display: block;
  }
  .hero__last {
    text-align: right;
  }
  .hero__note {
    position: absolute;
    z-index: 3;
    top: clamp(40px, 7vw, 110px);
    right: calc(var(--gutter) + 4%);
    padding: 18px 26px 22px;
  }
  .hero__note :global(.hero__oval) {
    position: absolute;
    inset: -6px -14px -14px -18px;
    width: calc(100% + 32px);
    height: calc(100% + 20px);
  }
  .hero__portrait {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 14%;
    bottom: 0;
    margin: 0;
    transform: translateX(-50%);
  }
  .hero__portrait :global(img) {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    filter: grayscale(1) contrast(1.05);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 70%, transparent 98%);
  }
  .hero__portrait :global(.scribbles) {
    left: 4%;
    top: -6%;
    width: 92%;
  }
  .hero :global(.hero__badge) {
    position: absolute;
    z-index: 3;
    right: calc(var(--gutter) + 18%);
    bottom: clamp(120px, 16vw, 230px);
  }
  .hero__intro {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: clamp(32px, 4vw, 56px);
    max-width: 330px;
  }
  /* «Выйди за рамки»: подпись вылезает за сетку до края экрана */
  .hero__escape {
    position: absolute;
    z-index: 3;
    right: 8px;
    bottom: clamp(32px, 4vw, 56px);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .hero__stage {
      min-height: 0;
      padding-block: 40px 32px;
    }
    .hero__note {
      position: relative;
      top: auto;
      right: auto;
      align-self: flex-end;
      margin: 0 8px 28px 0;
    }
    .hero__name {
      font-size: 17vw;
    }
    .hero__portrait {
      position: relative;
      left: auto;
      top: auto;
      width: 78%;
      margin: -8vw auto 0;
      transform: none;
    }
    .hero__portrait :global(img) {
      width: 100%;
      height: auto;
    }
    .hero :global(.hero__badge) {
      right: var(--gutter);
      bottom: 34%;
      width: 96px;
    }
    .hero__intro {
      position: relative;
      left: auto;
      bottom: auto;
      max-width: none;
      margin-top: 24px;
    }
    .hero__escape {
      position: relative;
      right: auto;
      bottom: auto;
      align-self: flex-end;
      margin: 16px -8px 0 0;
      font-size: 11px;
    }
  }

  /* ——— Кейсы ——— */
  .cases {
    padding-block: clamp(56px, 8vw, 112px);
  }
  .section-title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .section-title sup {
    font-size: 0.4em;
    vertical-align: top;
    margin-left: 4px;
    color: var(--muted);
    font-weight: 500;
  }
  .cases__list {
    display: grid;
    gap: clamp(32px, 3vw, 40px);
  }

  /* ——— Обо мне: свободная композиция, как на прежнем сайте ——— */
  .about-teaser {
    padding-bottom: clamp(72px, 10vw, 144px);
  }
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto 1fr;
    column-gap: var(--gap);
  }
  .about__label {
    grid-column: 1 / 8;
    grid-row: 1;
    font-family: var(--display);
    font-size: var(--fs-h3);
    color: var(--green);
    margin-bottom: clamp(20px, 2.4vw, 36px);
  }
  .about__headline {
    grid-column: 1 / 8;
    grid-row: 2;
    font-size: clamp(30px, 3vw, 44px);
    max-width: 720px;
  }
  .about__ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e4e4e2;
  }
  .about__ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .about__ph:hover :global(img) {
    filter: none;
  }
  .about__ph--portrait {
    grid-column: 1 / 4;
    grid-row: 3 / 5;
    align-self: start;
    margin-top: clamp(24px, 3.4vw, 48px);
    aspect-ratio: 6 / 5;
  }
  .about :global(.about__curve) {
    grid-column: 4 / 8;
    grid-row: 3;
    align-self: start;
    width: 100%;
    height: auto;
    aspect-ratio: 220 / 127;
    margin-top: -8px;
    transform: scaleX(-1);
  }
  .about__text {
    grid-column: 4 / 8;
    grid-row: 4;
    align-self: end;
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 420px;
  }
  .about__text p {
    line-height: 1.35;
  }
  .about__text .link-arrow {
    font-size: 12px;
  }
  .about__book {
    grid-column: 8 / 10;
    grid-row: 2 / 5;
    align-self: start;
    margin: 8px 0 0;
  }
  .about__ph--book {
    aspect-ratio: 7 / 5;
  }
  .about__hobbies {
    margin-top: 16px;
    font-size: 11px;
    text-align: right;
  }
  .about__ph--plane {
    grid-column: 10 / 13;
    grid-row: 2 / 5;
    align-self: start;
    margin-top: 8px;
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: none;
      row-gap: 24px;
    }
    .about__label,
    .about__headline {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .about__label {
      margin-bottom: 0;
    }
    .about__ph--portrait {
      grid-column: 1 / 5;
      grid-row: auto;
      margin-top: 8px;
    }
    .about :global(.about__curve) {
      grid-column: 3 / 7;
      grid-row: auto;
      margin-top: -72px;
      margin-bottom: -12px;
    }
    .about__text {
      grid-column: 1 / -1;
      grid-row: auto;
      max-width: none;
    }
    .about__book {
      grid-column: 1 / 5;
      grid-row: auto;
      margin-top: 16px;
    }
    .about__hobbies {
      text-align: left;
    }
    .about__ph--plane {
      grid-column: 3 / 7;
      grid-row: auto;
      margin-top: 0;
    }
  }
</style>
