---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Stack from '../components/Stack.astro';
import Line from '../components/Line.astro';
import { getSettings, getAbout, getCases, inline } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const s = await getSettings();
const about = await getAbout();
const cases = await getCases();
const name = L(s, 'name');
const role = L(s, 'role');
const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ');
const greeting = [...(L(s, 'greeting') || (lang === 'en' ? 'Hi!' : 'Привет!'))];
---

<Base theme="dark" lang={lang}>
  <section class="hero dark">
    <div class="container hero__grid">
      <h1 class="visually-hidden">{name} — {role}</h1>

      <p class="hero__greeting" aria-hidden="true" data-reveal="fade">
        {greeting.map((ch) => <span class="g">{ch === ' ' ? '\u00a0' : ch}</span>)}
      </p>

      <div class="hero__name">
        <p class="hero__note caps" data-reveal="fade">
          <Line name="oval" class="hero__oval" />
          {tx.heroNote[0]}<br />{tx.heroNote[1]}
        </p>
        <p class="hero__fullname" aria-hidden="true" data-reveal="lines">{firstName}<br />{lastName}</p>
        <p class="hero__role caps">{role}</p>
      </div>

      {
        s.heroPhoto && (
          <figure class="hero__photo hero__photo--small" data-reveal="img">
            <Image src={s.heroPhoto} alt={name} widths={[360, 720]} sizes="(max-width: 720px) 45vw, 22vw" loading="eager" />
          </figure>
        )
      }

      <div class="hero__intro">
        <p class="caps" data-reveal="lines">{L(s, 'intro')}</p>
      </div>

      {
        s.heroPhoto2 && (
          <figure class="hero__photo hero__photo--big">
            <div class="hero__frame" data-reveal="img">
              <Image src={s.heroPhoto2} alt="" widths={[600, 960, 1280]} sizes="(max-width: 720px) 100vw, 40vw" loading="eager" fetchpriority="high" />
            </div>
            <figcaption class="hero__escape caps" data-reveal="fade">{tx.photoFrames[0]}<br />{tx.photoFrames[1]}</figcaption>
          </figure>
        )
      }

      <p class="hero__location caps" data-reveal="fade" set:html={inline(L(s, 'location'))} />
    </div>
  </section>

  <section class="cases" id="cases">
    <div class="container">
      <h2 class="section-title" data-reveal="fade">{tx.casesTitle} <sup>{String(cases.length).padStart(2, '0')}</sup></h2>
      <div class="cases__list">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} lang={lang} />)}
      </div>
    </div>
  </section>

  <Stack lang={lang} />

  <section class="about-teaser">
    <div class="container about">
      <p class="about__label" data-reveal="fade">{tx.aboutLabel}</p>
      <h2 class="about__headline" data-reveal="lines">{L(about, 'headline')}</h2>

      {about.photos[0] && (
        <figure class="about__ph about__ph--portrait" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: -2deg">
          <Image src={about.photos[0]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}

      <Line name="curve" class="about__curve" />

      <div class="about__text">
        <p class="caps" data-reveal="lines">{L(about, 'text')}</p>
        <a class="link-arrow caps" href={href(lang, '/about')}>{tx.aboutMore}</a>
      </div>

      {about.photos[1] && (
        <figure class="about__book">
          <div class="about__ph about__ph--book" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: 3deg">
            <Image src={about.photos[1]} alt="" widths={[320, 640]} sizes="(max-width: 900px) 45vw, 16vw" loading="lazy" />
          </div>
          {L(about, 'hobbies') && <figcaption class="about__hobbies caps">{L(about, 'hobbies')}</figcaption>}
        </figure>
      )}

      {about.photos[2] && (
        <figure class="about__ph about__ph--plane" data-reveal="img" data-drag={tx.cursorDrag} style="rotate: -1.5deg">
          <Image src={about.photos[2]} alt="" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 26vw" loading="lazy" />
        </figure>
      )}
    </div>
  </section>
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-top: -1px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(24px, 3vw, 40px);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .hero__greeting {
    grid-column: 1 / 8;
    font-family: var(--display);
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    user-select: none;
  }
  .g {
    display: inline-block;
    font-variation-settings: 'wght' 700;
    transition: font-variation-settings 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .g:hover {
    font-variation-settings: 'wght' 400;
    transform: translateY(-0.04em);
  }
  .hero__name {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .hero__note {
    position: relative;
    margin: clamp(8px, 2vw, 32px) clamp(40px, 8vw, 140px) clamp(16px, 2vw, 28px) 0;
    padding: 18px 26px 22px;
    text-align: left;
  }
  .hero__note :global(.hero__oval) {
    position: absolute;
    inset: -6px -14px -14px -18px;
    width: calc(100% + 32px);
    height: calc(100% + 20px);
  }
  .hero__fullname {
    font-family: var(--display);
    font-size: clamp(56px, 8.4vw, 132px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  /* роль в hero показываем только на телефоне — на десктопе она в шапке */
  .hero__role {
    display: none;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .hero__photo {
    position: relative;
    margin: 0;
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .hero__photo:hover :global(img) {
    filter: grayscale(0);
  }
  .hero__photo--small {
    grid-column: 1 / 4;
    grid-row: 2 / 4;
    align-self: end;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 4px;
    background: #2a2a26;
  }



  .hero__intro {
    grid-column: 4 / 8;
    grid-row: 3;
    align-self: end;
    display: grid;
    gap: 14px;
    max-width: 420px;
  }
  .hero__intro p {
    font-size: var(--fs-caps);
    line-height: 1.35;
  }
  .hero__photo--big {
    grid-column: 8 / 13;
    grid-row: 3 / 5;
  }
  .hero__frame {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 4px;
    background: #2a2a26;
  }
  /* «Выйди за рамки»: подпись начинается на фото и вылезает за сетку до края экрана */
  .hero__escape {
    position: absolute;
    right: calc(-1 * var(--gutter) + 8px);
    bottom: 18px;
    color: #fff;
    white-space: nowrap;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  .hero__location {
    grid-column: 1 / 8;
    grid-row: 4;
    align-self: end;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .hero__greeting {
      grid-column: 1 / -1;
    }
    .hero__name {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hero__role {
      display: inline-flex;
    }
    .hero__photo--small {
      grid-column: 1 / 3;
      grid-row: auto;
    }
    .hero__intro {
      grid-column: 3 / -1;
      grid-row: auto;
      max-width: none;
    }
    .hero__photo--big {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-bottom: 28px;
    }
    .hero__escape {
      bottom: -24px;
      font-size: 11px;
      text-align: right;
    }
    .hero__location {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  @media (max-width: 560px) {
    .hero__note {
      margin-right: 8px;
    }
    .hero__photo--small {
      display: none;
    }
    .hero__intro {
      grid-column: 1 / -1;
    }
  }

  /* ——— Кейсы ——— */
  .cases {
    padding-block: clamp(56px, 8vw, 112px);
  }
  .section-title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .section-title sup {
    font-size: 0.4em;
    vertical-align: top;
    margin-left: 4px;
    color: var(--muted);
    font-weight: 500;
  }
  .cases__list {
    display: grid;
    gap: clamp(32px, 3vw, 40px);
  }

  /* ——— Обо мне: свободная композиция, как на прежнем сайте ——— */
  .about-teaser {
    padding-bottom: clamp(72px, 10vw, 144px);
  }
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto 1fr;
    column-gap: var(--gap);
  }
  .about__label {
    grid-column: 1 / 8;
    grid-row: 1;
    font-family: var(--display);
    font-size: var(--fs-h3);
    color: var(--accent);
    margin-bottom: clamp(20px, 2.4vw, 36px);
  }
  .about__headline {
    grid-column: 1 / 8;
    grid-row: 2;
    font-size: clamp(30px, 3vw, 44px);
    max-width: 720px;
  }
  .about__ph {
    margin: 0;
    overflow: hidden;
    background: #e4e4e2;
  }
  .about__ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease);
  }
  .about__ph:hover :global(img) {
    filter: none;
  }
  .about__ph--portrait {
    grid-column: 1 / 4;
    grid-row: 3 / 5;
    align-self: start;
    margin-top: clamp(24px, 3.4vw, 48px);
    aspect-ratio: 6 / 5;
  }
  .about :global(.about__curve) {
    grid-column: 4 / 8;
    grid-row: 3;
    align-self: start;
    width: 100%;
    height: auto;
    aspect-ratio: 220 / 127;
    margin-top: -8px;
    transform: scaleX(-1);
  }
  .about__text {
    grid-column: 4 / 8;
    grid-row: 4;
    align-self: end;
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 420px;
  }
  .about__text p {
    line-height: 1.35;
  }
  .about__text .link-arrow {
    font-size: 12px;
  }
  .about__book {
    grid-column: 8 / 10;
    grid-row: 2 / 5;
    align-self: start;
    margin: 8px 0 0;
  }
  .about__ph--book {
    aspect-ratio: 7 / 5;
  }
  .about__hobbies {
    margin-top: 16px;
    font-size: 11px;
    text-align: right;
  }
  .about__ph--plane {
    grid-column: 10 / 13;
    grid-row: 2 / 5;
    align-self: start;
    margin-top: 8px;
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: none;
      row-gap: 24px;
    }
    .about__label,
    .about__headline {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .about__label {
      margin-bottom: 0;
    }
    .about__ph--portrait {
      grid-column: 1 / 5;
      grid-row: auto;
      margin-top: 8px;
    }
    .about :global(.about__curve) {
      grid-column: 3 / 7;
      grid-row: auto;
      margin-top: -72px;
      margin-bottom: -12px;
    }
    .about__text {
      grid-column: 1 / -1;
      grid-row: auto;
      max-width: none;
    }
    .about__book {
      grid-column: 1 / 5;
      grid-row: auto;
      margin-top: 16px;
    }
    .about__hobbies {
      text-align: left;
    }
    .about__ph--plane {
      grid-column: 3 / 7;
      grid-row: auto;
      margin-top: 0;
    }
  }
</style>
