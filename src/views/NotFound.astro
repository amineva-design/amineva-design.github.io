---
import Base from '../layouts/Base.astro';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
---

<Base title={tx.notFoundTitle} lang={lang}>
  <section class="container nf">
    <h1>404</h1>
    <p>{tx.notFoundText}</p>
    <a class="btn btn--accent" href={href(lang, '/')}>{tx.toHome}</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(80px, 14vw, 200px);
  }
  .nf h1 {
    font-size: clamp(96px, 18vw, 240px);
    letter-spacing: -0.05em;
  }
</style>
