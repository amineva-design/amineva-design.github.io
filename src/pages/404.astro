---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена">
  <section class="container nf">
    <h1>404</h1>
    <p>Такой страницы нет — возможно, кейс переехал.</p>
    <a class="btn btn--accent" href="/">На главную</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(80px, 14vw, 200px);
  }
  .nf h1 {
    font-size: clamp(96px, 18vw, 240px);
    letter-spacing: -0.05em;
  }
</style>
