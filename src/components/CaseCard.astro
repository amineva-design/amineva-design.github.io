---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href as link, loc, t, type Lang } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
  lang: Lang;
}
const { entry, index, lang } = Astro.props;
const c = entry.data;
const tx = t(lang);
const href = link(lang, `/cases/${entry.id}`);
const title = loc(c, 'title', lang);
const summary = loc(c, 'summary', lang);
const sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 900px';
const eager = index === 0;
---

<a class="case" href={href} aria-label={tx.caseAria(title)} data-cursor={tx.cursorView} data-reveal="fade">
  <div class="case__info">
    <div>
      <h3 class="case__title">{title}</h3>
      {summary && <p class="case__summary">{summary}</p>}
    </div>

    {
      c.metrics.length > 0 && (
        <ul class="case__metrics">
          {c.metrics.slice(0, 2).map((m) => (
            <li>
              <b>{m.value}</b> {loc(m, 'label', lang)}
            </li>
          ))}
        </ul>
      )
    }

    <div class="case__meta">
      <div>
        <span class="label">{tx.direction}</span>
        <span>{loc(c, 'direction', lang)}</span>
      </div>
      <div>
        <span class="label">{tx.year}</span>
        <span>{c.year}</span>
      </div>
      <span class="case__arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </div>
  </div>

  <div class="case__media" transition:name={`case-${entry.id}`}>
    {
      c.cardImage && (
        <Image src={c.cardImage} alt="" widths={[640, 1000, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
      )
    }
  </div>

</a>

<style>
  /* кейс — один цельный блок: текст слева, картинка справа, без зазора */
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
  }
  .case__info,
  .case__media {
    overflow: hidden;
  }
  .case__media {
    aspect-ratio: 16 / 10;
  }
  .case__info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(24px, 3vw, 48px);
    background: var(--card);
    transition: box-shadow 0.3s var(--ease);
  }
  .case__title {
    font-size: var(--fs-h3);
  }
  .case__summary {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.5;
  }
  .case__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .case__metrics b {
    color: var(--ink);
    font-weight: 700;
    font-family: var(--display);
    font-size: 16px;
    margin-right: 4px;
  }
  .case__meta {
    display: flex;
    align-items: flex-end;
    gap: 32px;
    font-size: 15px;
  }
  .case__meta > div {
    display: grid;
    gap: 2px;
  }
  .case__meta > div:nth-child(2) {
    white-space: nowrap;
  }
  .case__arrow {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    transition: transform 0.35s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .case__arrow {
      display: none;
    }
  }
  .case__arrow svg {
    width: 16px;
    height: 16px;
    transition: transform 0.35s var(--ease);
  }
  .case__media {
    background: #e4e4e2;
  }
  .case__media :global(img),
  .case__media iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .case__media iframe {
    border: 0;
    pointer-events: none;
    transform: scale(1.02);
  }
  .case:hover .case__media :global(img) {
    transform: scale(1.04);
  }
  .case:hover .case__arrow svg {
    transform: translate(2px, -2px);
  }


  @media (max-width: 1024px) {
    .case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
    .case__media {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
  @media (max-width: 640px) {
    .case {
      grid-template-columns: 1fr;
    }
    .case__media {
      order: -1;
      aspect-ratio: 16 / 10;
    }
    .case__summary {
      margin-top: 10px;
    }
  }
</style>
