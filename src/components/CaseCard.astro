---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href as link, loc, t, type Lang } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
  lang: Lang;
}
const { entry, index, lang } = Astro.props;
const c = entry.data;
const tx = t(lang);
const href = link(lang, `/cases/${entry.id}`);
const title = loc(c, 'title', lang);
const summary = loc(c, 'summary', lang);
const sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 900px';
const eager = index === 0;
---

<a class="case" href={href} aria-label={tx.caseAria(title)} data-cursor={tx.cursorView} data-reveal="fade">
  <div class="case__info">
    <div>
      <h3 class="case__title">{title}</h3>
      {summary && <p class="case__summary">{summary}</p>}
    </div>

    {
      c.metrics.length > 0 && (
        <ul class="case__metrics">
          {c.metrics.slice(0, 2).map((m) => (
            <li>
              <b>{m.value}</b> {loc(m, 'label', lang)}
            </li>
          ))}
        </ul>
      )
    }

    <div class="case__meta">
      <div>
        <span class="label">{tx.direction}</span>
        <span>{loc(c, 'direction', lang)}</span>
      </div>
      <div>
        <span class="label">{tx.year}</span>
        <span>{c.year}</span>
      </div>
      <span class="case__view" aria-hidden="true">{tx.cursorView}</span>
    </div>
  </div>

  <div class="case__media" transition:name={`case-${entry.id}`}>
    {
      c.cardImage && (
        <Image src={c.cardImage} alt="" widths={[640, 1000, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
      )
    }
  </div>

</a>

<style>
  /* На телефоне вместо курсора-плашки — такая же зелёная плашка «Смотреть» прямо в карточке.
     На компьютере её роль играет курсор, поэтому там плашки нет */
  .case__view {
    margin-left: auto;
    align-self: flex-end;
    padding: 8px 12px;
    background: var(--accent);
    color: var(--ink);
    font-family: var(--display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .case__view {
      display: none;
    }
  }
  /* кейс — один цельный блок: текст слева, картинка справа, без зазора */
  .case {
    display: grid;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    text-decoration: none;
  }
  .case__info,
  .case__media {
    overflow: hidden;
  }
  .case__media {
    aspect-ratio: 16 / 10;
  }
  .case__info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(24px, 3vw, 48px);
    background: var(--card);
    transition: box-shadow 0.3s var(--ease);
  }
  .case__title {
    font-size: var(--fs-h3);
  }
  .case__summary {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.5;
  }
  .case__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .case__metrics b {
    color: var(--ink);
    font-weight: 700;
    font-family: var(--display);
    font-size: 16px;
    margin-right: 4px;
  }
  .case__meta {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    font-size: 15px;
  }
  .case__meta > div {
    display: grid;
    gap: 2px;
  }
  .case__meta > div:nth-child(2) {
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .case__media {
    background: #e4e4e2;
  }
  .case__media :global(img),
  .case__media iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease), filter 0.7s var(--ease);
  }
  /* обложки ч/б, чтобы разноцветные кейсы не спорили; при наведении на любую часть карточки — цвет.
     На устройствах без наведения (телефон) — сразу в цвете */
  @media (hover: hover) and (pointer: fine) {
    .case__media :global(img),
    .case__media iframe {
      filter: grayscale(1);
    }
    .case:hover .case__media :global(img),
    .case:hover .case__media iframe,
    .case:focus-visible .case__media :global(img) {
      filter: grayscale(0);
    }
  }
  .case__media iframe {
    border: 0;
    pointer-events: none;
    transform: scale(1.02);
  }
  .case:hover .case__media :global(img) {
    transform: scale(1.04);
  }


  @media (max-width: 1024px) {
    .case__media {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
  /* текст ровно на 5 колонок сетки, картинка начинается с 6-й — как фото в «Обо мне» и инструменты в стеке.
     Только для экранов шире телефона: так правило не перебивает мобильную раскладку в одну колонку */
  @media (min-width: 641px) {
    .case {
      grid-template-columns: calc((100% - 11 * var(--gap)) * 5 / 12 + 5 * var(--gap)) minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .case {
      grid-template-columns: 1fr;
    }
    .case__media {
      order: -1;
      aspect-ratio: 16 / 10;
    }
    .case__summary {
      margin-top: 10px;
    }
  }
</style>
