---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { href as link, loc, t, withBase, type Lang } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
  lang: Lang;
}
const { entry, index, lang } = Astro.props;
const c = entry.data;
const tx = t(lang);
const href = link(lang, `/cases/${entry.id}`);
const title = loc(c, 'title', lang);
const summary = loc(c, 'summary', lang);
// «Направление» через запятую → теги-пилюли
const tags = loc(c, 'direction', lang).split(',').map((x) => x.trim()).filter(Boolean);
const sizes = '(max-width: 640px) 100vw, 50vw';
const eager = index === 0;
// видео на обложке (если загружено): крутится без звука, первый кадр до загрузки — обычная обложка
const poster = c.coverVideo && c.cardImage ? await getImage({ src: c.cardImage, width: 800, format: 'jpg' }) : null;
---

<a class="case" href={href} aria-label={tx.caseAria(title)} data-cursor={tx.cursorView} data-reveal="fade">
  <div class="case__media" transition:name={`case-${entry.id}`} style={`--pos: ${c.cardPosition}`}>
    {
      c.coverVideo ? (
        <video src={withBase(c.coverVideo)} poster={poster?.src} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
      ) : (
        c.cardImage && (
          <Image src={c.cardImage} alt="" widths={[640, 1000, 1400]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
        )
      )
    }
  </div>
  <div class="case__info">
    <h3 class="case__title">{title}</h3>
    {summary && <p class="case__summary">{summary}</p>}
    {tags.length > 0 && (
      <ul class="case__tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </div>
</a>

<script>
  // Видео на обложках запускаем явно: после перехода между страницами браузер сам autoplay не включает
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLVideoElement>('.case__media video').forEach((v) => {
      v.muted = true;
      v.play().catch(() => {});
    });
  });
</script>

<style>
  /* карточка кейса: квадратная обложка, под ней название, что делалось и направление */
  .case {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    text-decoration: none;
  }
  .case__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #e4e4e2;
  }
  .case__media :global(img),
  .case__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
    transition: transform 0.6s var(--ease);
  }
  .case:hover .case__media :global(img),
  .case:hover .case__media video {
    transform: scale(1.04);
  }
  /* карточки в ряду одной высоты — теги прижаты к низу, чтобы стояли на одной линии */
  .case__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.2vw, 32px);
  }
  .case__title {
    font-size: var(--fs-h3);
  }
  .case__summary {
    font-size: 16px;
    line-height: 1.5;
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 6px 0 0;
    list-style: none;
  }
  .case__tags li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper);
    font-size: 13px;
    line-height: 1.2;
    color: var(--ink);
  }
</style>
