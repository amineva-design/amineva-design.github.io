<style>
  .scribbles {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .scribbles path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* без анимации видна только первая группа */
  .scribbles g:not(:first-child) {
    display: none;
  }
  :global(html.motion) .scribbles g {
    display: block;
  }
  :global(html.motion) .scribbles path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
</style>
