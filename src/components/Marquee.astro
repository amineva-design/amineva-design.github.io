---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: (ImageMetadata | null | undefined)[];
  frame?: 'none' | 'phone';
  reverse?: boolean;
  caption?: string;
}
const { images, frame = 'none', reverse = false, caption } = Astro.props;
const list = images.filter(Boolean) as ImageMetadata[];
// Набираем минимум 8 элементов, чтобы лента заполняла широкий экран, затем дублируем для бесшовного цикла
const base: ImageMetadata[] = [];
while (list.length && base.length < 8) base.push(...list);
const duration = base.length * (frame === 'phone' ? 5 : 4);
const width = frame === 'phone' ? 260 : 360;
---

{
  list.length > 0 && (
    <figure class:list={['marquee', `marquee--${frame}`, reverse && 'is-reverse']} style={`--dur: ${duration}s`}>
      <div class="marquee__viewport">
        <div class="marquee__track">
          {[0, 1].map((copy) =>
            base.map((img) => (
              <div class="marquee__item" aria-hidden={copy === 1 ? 'true' : undefined}>
                <Image src={img} alt="" widths={[width, width * 2]} sizes={`${width}px`} loading="eager" decoding="async" fetchpriority="low" />
              </div>
            ))
          )}
        </div>
      </div>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .marquee {
    margin: 0;
    /* Ширина и сдвиг задаются из страницы кейса (--bleed-*), чтобы лента уходила за правый край экрана */
    width: var(--bleed-width, 100%);
    margin-left: var(--bleed-left, 0px);
  }
  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 24px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 24px), transparent);
  }
  .marquee__track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    padding-block: 4px;
    animation: marquee var(--dur) linear infinite;
  }
  .is-reverse .marquee__track {
    animation-direction: reverse;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--gap) / 2));
    }
  }
  .marquee__item {
    flex: none;
  }
  .marquee__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Квадратные карточки */
  .marquee--none .marquee__item {
    width: clamp(220px, 26vw, 360px);
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: #e4e4e2;
  }

  /* Рамка телефона */
  .marquee--phone .marquee__item {
    position: relative;
    width: clamp(180px, 18vw, 260px);
    aspect-ratio: 9 / 19.5;
    padding: 8px;
    border-radius: 40px;
    background: #111;
    box-shadow: 0 0 0 1px #3a3a3a inset, 0 20px 40px rgba(20, 20, 18, 0.12);
  }
  .marquee--phone .marquee__item :global(img) {
    border-radius: 32px;
    object-position: top;
    background: #fff;
  }
  .marquee--phone .marquee__item::after {
    content: '';
    position: absolute;
    top: 16px;
    left: 50%;
    width: 30%;
    height: 18px;
    border-radius: 999px;
    background: #111;
    transform: translateX(-50%);
  }

  figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      overflow-x: auto;
    }
    .marquee__track {
      animation: none;
    }
  }
</style>
