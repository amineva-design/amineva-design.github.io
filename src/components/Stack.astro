---
// Стек: редакционный список — номер, категория, инструменты крупно через «/».
// При наведении строка заливается фирменным цветом.
import { getAbout } from '../lib/content';
import { loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const about = await getAbout();
const L = (o: Record<string, any>, k: string) => loc(o, k, lang);
const rows = [
  ...about.tools.map((tool) => ({
    name: L(tool, 'name'),
    items: L(tool, 'details')
      .split(',')
      .map((x) => x.trim())
      .filter(Boolean),
  })),
  ...(L(about, 'languages') ? [{ name: tx.languages, items: [L(about, 'languages')] }] : []),
];
---

<section class="stack" id="stack">
  <div class="container">
    <h2 class="stack__title" data-reveal="fade">{tx.stack}</h2>
    <ol class="stack__rows">
      {
        rows.map((row, i) => (
          <li class="stack__row" data-reveal="fade">
            <span class="stack__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="stack__name">{row.name}</span>
            <span class="stack__items">
              {row.items.map((item, j) => (
                <>
                  {j > 0 && <span class="stack__slash">/</span>}
                  <span class="stack__item">{item}</span>
                </>
              ))}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .stack {
    padding-bottom: clamp(72px, 10vw, 144px);
  }
  .stack__title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .stack__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .stack__row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--gap);
    align-items: baseline;
    padding: clamp(16px, 1.8vw, 26px) 12px;
    border-top: 1px solid var(--line);
    isolation: isolate;
  }
  .stack__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .stack__row:hover::before {
    transform: scaleX(1);
  }
  .stack__num {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
    color: var(--muted);
    transition: color 0.3s;
  }
  .stack__name {
    font-family: var(--display);
    font-size: var(--fs-caps);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .stack__items {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4em;
    font-family: var(--display);
    font-size: clamp(24px, 2.6vw, 40px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .stack__slash {
    color: var(--accent);
    font-weight: 400;
    transition: color 0.3s;
  }
  .stack__row:hover .stack__slash,
  .stack__row:hover .stack__num {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .stack__row {
      grid-template-columns: 36px minmax(0, 1fr);
      row-gap: 8px;
      padding-inline: 0;
    }
    .stack__items {
      grid-column: 1 / -1;
      font-size: 22px;
    }
  }
</style>
