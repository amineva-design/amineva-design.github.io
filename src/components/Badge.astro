---
// Вращающийся круглый бейдж с текстом по кругу (как у Woodside)
interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
const id = `badge-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['badge', cls]} aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <defs>
      <path id={id} d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" />
    </defs>
    <circle cx="100" cy="100" r="100" class="badge__bg" />
    <g class="badge__ring">
      <text>
        <textPath href={`#${id}`} textLength="452" lengthAdjust="spacing">{text}</textPath>
      </text>
    </g>
    <path class="badge__star" d="M100 78 C102 94 106 98 122 100 C106 102 102 106 100 122 C98 106 94 102 78 100 C94 98 98 94 100 78 Z" />
  </svg>
</div>

<style>
  .badge {
    width: clamp(110px, 11vw, 160px);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .badge svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .badge__bg {
    fill: var(--accent);
  }
  .badge__ring {
    transform-origin: 100px 100px;
    animation: badge-spin 18s linear infinite;
  }
  .badge text {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--ink);
  }
  .badge__star {
    fill: var(--ink);
  }
  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
