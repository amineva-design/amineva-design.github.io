---
import LangSwitch from './LangSwitch.astro';
import Line from './Line.astro';
import { getSettings, resumeHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  theme?: 'dark' | 'light';
  lang: Lang;
}
const { theme = 'light', lang } = Astro.props;
const s = await getSettings();
const tx = t(lang);
const resume = resumeHref(s, lang);
const nav = [
  { href: href(lang, '/#cases'), label: tx.nav.cases },
  { href: href(lang, '/about'), label: tx.nav.about },
  { href: '#contacts', label: tx.nav.contacts },
];
---

<header class:list={['header', 'caps', theme === 'dark' && 'dark']}>
  <div class="container header__bar">
    <div class="header__left">
      {
        resume && (
          <a class="header__resume" href={resume} target="_blank" rel="noopener">
            {tx.resume}
            <Line name="double" class="header__resume-line" />
          </a>
        )
      }
    </div>

    <a class="header__role" href={href(lang, '/')}>{loc(s, 'role', lang)}</a>

    <div class="header__right">
      {
        s.openToWork && (
          <span class="header__status">
            <span class="dot" aria-hidden="true" />
            {tx.openToWork}
          </span>
        )
      }
      <LangSwitch lang={lang} />
      <details class="header__menu">
        <summary aria-label={tx.menu}><span></span><span></span></summary>
        <div class="header__sheet">
          {s.openToWork && <span class="header__sheet-status"><span class="dot" aria-hidden="true" />{tx.openToWork}</span>}
          <a href={href(lang, '/')}>{tx.home}</a>
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
          {resume && <a href={resume} target="_blank" rel="noopener">{tx.resume}</a>}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Закрываем мобильное меню после перехода по ссылке
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('.header__sheet a').forEach((a) =>
      a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
    );
  });
</script>

<style>
  /* линия на всю ширину экрана */
  .header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }
  .header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    min-height: 64px;
  }
  .header a {
    text-decoration: none;
  }
  .header__resume {
    position: relative;
    display: inline-block;
    padding: 8px 0;
  }
  .header__resume :global(.header__resume-line) {
    position: absolute;
    left: -6%;
    bottom: 0;
    width: 112%;
    height: 8px;
    transition: transform 0.4s var(--ease);
    transform-origin: left;
  }
  .header__resume:hover :global(.header__resume-line) {
    transform: scaleX(1.08);
  }
  .header__role {
    text-align: center;
    transition: color 0.2s;
  }
  .header__role:hover {
    color: var(--accent);
  }
  .header__right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 24px;
  }
  .header__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(255, 42, 0, 0.6);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(255, 42, 0, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 42, 0, 0);
    }
  }

  .header__menu {
    display: none;
    position: relative;
  }
  .header__menu summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }
  .header__menu summary::-webkit-details-marker {
    display: none;
  }
  .header__menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }
  .header__menu[open] summary span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .header__menu[open] summary span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .header__sheet {
    position: absolute;
    right: -6px;
    top: 52px;
    min-width: 230px;
    display: grid;
    padding: 8px;
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }
  .header__sheet a {
    padding: 12px 14px;
    border-radius: var(--radius);
    font-size: 15px;
  }
  .header__sheet a:hover {
    background: var(--paper);
  }
  .header__sheet-status {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px 6px;
    color: #6b6b66;
  }

  @media (max-width: 900px) {
    .header__bar {
      grid-template-columns: 1fr auto;
    }
    .header__role,
    .header__status {
      display: none;
    }
    .header__menu {
      display: block;
    }
    .header__right {
      gap: 14px;
    }
  }
</style>
