---
import { Image } from 'astro:assets';
import { getSettings, resumeHref, telegramHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const s = await getSettings();
const resume = resumeHref(s, lang);
const tg = telegramHref(s.telegram);
const year = new Date().getFullYear();
---

<footer class="footer dark" id="contacts">
  <div class="container">
    <div class="footer__top">
      <div class="footer__cta">
        <h2 class="footer__title" set:html={tx.footerTitle} />
        <p class="footer__status">{loc(s, 'statusText', lang)}</p>
        <div class="footer__buttons">
          {tg && <a class="btn btn--accent" href={tg} target="_blank" rel="noopener">{tx.writeTelegram}</a>}
          {s.email && <a class="btn btn--ghost" href={`mailto:${s.email}`}>{tx.writeEmail}</a>}
        </div>
      </div>
      {
        s.footerImage && (
          <Image class="footer__img" src={s.footerImage} alt="" widths={[240, 480]} sizes="240px" loading="lazy" />
        )
      }
    </div>

    <div class="footer__cols">
      <div>
        <p class="label">{tx.contactsLabel}</p>
        <ul>
          {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
          {tg && <li><a href={tg} target="_blank" rel="noopener">@{s.telegram.replace(/^@/, '')}</a></li>}
          {resume && <li><a href={resume} target="_blank" rel="noopener">{tx.resume} ↗</a></li>}
        </ul>
      </div>
      <div>
        <p class="label">{tx.socialsLabel}</p>
        <ul>
          {s.socials.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{loc(l, 'label', lang)}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label">{tx.siteLabel}</p>
        <ul>
          <li><a href={href(lang, '/')}>{tx.home}</a></li>
          <li><a href={href(lang, '/#cases')}>{tx.nav.cases}</a></li>
          <li><a href={href(lang, '/about')}>{tx.nav.about}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {loc(s, 'name', lang)} · <a href={href(lang, '/privacy')}>{tx.privacy}</a></span>
      <a href="#main">{tx.toTop}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(56px, 8vw, 112px);
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }
  .footer__title {
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .footer__title :global(.nw) {
    white-space: nowrap;
  }
  .footer__title :global(mark) {
    display: inline-block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0.04em;
    padding: 0 0.08em;
    background: var(--accent);
    color: var(--ink);
    transform: rotate(-3deg);
  }
  .footer__status {
    margin-top: 20px;
    color: var(--muted);
    font-size: 18px;
  }
  .footer__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .footer__img {
    width: 240px;
    height: auto;
    border-radius: 12px;
    border: 2px solid var(--accent);
    flex-shrink: 0;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: 40px;
  }
  .footer ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .footer ul a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer ul a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .footer__bottom a {
    text-decoration: none;
    color: var(--paper);
  }
  .footer__bottom span a {
    color: inherit;
    transition: color 0.2s;
  }
  .footer__bottom span a:hover {
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer__img {
      width: 180px;
    }
    .footer__cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
    .footer__cols > div:first-child {
      grid-column: 1 / -1;
    }
    .footer__buttons .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
