---
import AsciiPortrait from './AsciiPortrait.astro';
import handLeft from '../assets/site/hand-left.png';
import handRight from '../assets/site/hand-right.png';
import { getSettings, resumeHref, telegramHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const s = await getSettings();
const resume = resumeHref(s, lang);
const tg = telegramHref(s.telegram);
const year = new Date().getFullYear();
---

<footer class="footer dark" id="contacts">
  <!-- руки как на фреске «Сотворение Адама», из символов; между ними — статус -->
  <div class="footer__hands">
    <div class="footer__hand footer__hand--left"><AsciiPortrait src={handLeft} alt="" align="left" /></div>
    <p class="footer__hands-text">{loc(s, 'statusText', lang)}</p>
    <div class="footer__hand footer__hand--right"><AsciiPortrait src={handRight} alt="" align="right" /></div>
  </div>

  <div class="container">
    <div class="footer__cols">
      <div>
        <p class="footer__label">{tx.contactsLabel}</p>
        <ul>
          {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
          {tg && <li><a href={tg} target="_blank" rel="noopener">Tg @{s.telegram.replace(/^@/, '')}</a></li>}
          {resume && <li><a href={resume} target="_blank" rel="noopener">{tx.resume}</a></li>}
        </ul>
      </div>
      <div>
        <p class="footer__label">{tx.socialsLabel}</p>
        <ul>
          {s.socials.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{loc(l, 'label', lang)}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer__label">{tx.siteLabel}</p>
        <ul>
          <li><a href={href(lang, '/')}>{tx.home}</a></li>
          <li><a href={href(lang, '/#cases')}>{tx.nav.cases}</a></li>
          <li><a href={href(lang, '/about')}>{tx.nav.about}</a></li>
        </ul>
      </div>
    </div>

  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-row">
      <span class="footer__copy">© {year} {loc(s, 'name', lang)} <a href={href(lang, '/privacy')}>{tx.privacy}</a></span>
      <a href="#main">{tx.toTop}</a>
    </div>
  </div>
</footer>

<style>
  /* подпись колонок — прежний стиль, не зависит от общего .label */
  .footer__label {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.3;
  }
  .footer {
    padding-top: clamp(40px, 5vw, 72px);
  }
  .footer__copy a {
    margin-left: 24px;
  }
  @media (max-width: 720px) {
    .footer__copy a {
      display: block;
      margin: 6px 0 0;
    }
  }







  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: 40px;
  }
  .footer ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .footer ul a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer ul a:hover {
    color: var(--accent);
  }
  .footer__hands {
    position: relative;
    height: clamp(170px, 22vw, 340px);
    display: grid;
    place-items: center;
  }
  .footer__hand {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 42%;
  }
  .footer__hand--left {
    left: 0;
  }
  .footer__hand--right {
    right: 0;
  }
  .footer__hands-text {
    position: relative;
    z-index: 1;
    max-width: 22ch;
    text-align: center;
    font-size: clamp(15px, 1.3vw, 19px);
    line-height: 1.4;
    color: var(--paper);
  }
  @media (max-width: 720px) {
    .footer__hand {
      width: 50%;
    }
    .footer__hands {
      height: auto;
      padding-top: 34vw;
    }
    .footer__hand {
      height: 32vw;
      bottom: auto;
    }
    .footer__hands-text {
      max-width: 24ch;
      font-size: 14px;
    }
  }

  /* линия на всю ширину экрана */
  .footer__bottom {
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .footer__bottom-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px 32px;
  }
  .footer__bottom a {
    text-decoration: none;
    color: var(--paper);
  }
  .footer__bottom span a {
    color: inherit;
    transition: color 0.2s;
  }
  .footer__bottom span a:hover {
    color: var(--paper);
  }

  @media (max-width: 720px) {
  
    .footer__cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
    .footer__cols > div:first-child {
      grid-column: 1 / -1;
    }

  }
</style>
