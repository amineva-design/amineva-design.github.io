---
import AsciiPortrait from './AsciiPortrait.astro';
import handLeft from '../assets/site/hand-left.png';
import handRight from '../assets/site/hand-right.png';
import { getSettings, resumeHref, telegramHref } from '../lib/content';
import { href, loc, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const s = await getSettings();
const resume = resumeHref(s, lang);
const tg = telegramHref(s.telegram);
const year = new Date().getFullYear();
---

<footer class="footer dark" id="contacts">
  <div class="container">
    <div class="footer__top">
      <div class="footer__cta">
        <h2 class="footer__title" data-reveal="fade" set:html={tx.footerTitle} />
        <p class="footer__status">{loc(s, 'statusText', lang)}</p>
        <div class="footer__buttons">
          {tg && <a class="btn btn--accent" href={tg} target="_blank" rel="noopener">{tx.writeTelegram}</a>}
          {s.email && <a class="btn btn--ghost" href={`mailto:${s.email}`}>{tx.writeEmail}</a>}
        </div>
      </div>
    </div>

    <div class="footer__cols">
      <div>
        <p class="label">{tx.contactsLabel}</p>
        <ul>
          {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
          {tg && <li><a href={tg} target="_blank" rel="noopener">Tg @{s.telegram.replace(/^@/, '')}</a></li>}
          {resume && <li><a href={resume} target="_blank" rel="noopener">{tx.resume} ↗</a></li>}
        </ul>
      </div>
      <div>
        <p class="label">{tx.socialsLabel}</p>
        <ul>
          {s.socials.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{loc(l, 'label', lang)}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label">{tx.siteLabel}</p>
        <ul>
          <li><a href={href(lang, '/')}>{tx.home}</a></li>
          <li><a href={href(lang, '/#cases')}>{tx.nav.cases}</a></li>
          <li><a href={href(lang, '/about')}>{tx.nav.about}</a></li>
        </ul>
      </div>
    </div>

  </div>

  <!-- руки как на фреске «Сотворение Адама», из символов -->
  <div class="footer__hands">
    <div class="footer__hand footer__hand--left"><AsciiPortrait src={handLeft} alt="" align="left" /></div>
    <p class="footer__hands-text">{loc(s, 'name', lang)}<br />{loc(s, 'role', lang)}</p>
    <div class="footer__hand footer__hand--right"><AsciiPortrait src={handRight} alt="" align="right" /></div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-row">
      <span>© {year} {loc(s, 'name', lang)} · <a href={href(lang, '/privacy')}>{tx.privacy}</a></span>
      <a href="#main">{tx.toTop}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(56px, 8vw, 112px);
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  .footer__title {
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .footer__title :global(.nw) {
    white-space: nowrap;
  }
  .footer__title :global(mark) {
    display: inline-block;
    margin: 0 0.04em;
    padding: 0 0.08em;
    background: var(--accent);
    color: var(--ink);
    transform: rotate(-3deg);
  }
  .footer__status {
    margin-top: 20px;
    color: var(--muted);
    font-size: 18px;
  }
  .footer__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: 40px;
  }
  .footer ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .footer ul a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer ul a:hover {
    color: var(--accent);
  }
  .footer__hands {
    position: relative;
    height: clamp(150px, 19vw, 300px);
    display: grid;
    place-items: center;
  }
  .footer__hand {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40%;
  }
  .footer__hand--left {
    left: 0;
  }
  .footer__hand--right {
    right: 0;
  }
  .footer__hands-text {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .footer__hand {
      width: 50%;
    }
    .footer__hands-text {
      display: none;
    }
  }

  /* линия на всю ширину экрана */
  .footer__bottom {
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .footer__bottom-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px 32px;
  }
  .footer__bottom a {
    text-decoration: none;
    color: var(--paper);
  }
  .footer__bottom span a {
    color: inherit;
    transition: color 0.2s;
  }
  .footer__bottom span a:hover {
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer__cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
    .footer__cols > div:first-child {
      grid-column: 1 / -1;
    }
    .footer__buttons .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
