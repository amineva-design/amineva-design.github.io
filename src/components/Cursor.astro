---
// Обычный системный курсор везде. Над карточками кейсов ([data-cursor]) и фото коллажа ([data-drag])
// он заменяется тёмным кругом с подписью. Только для мыши; на тачскринах ничего не показывается.
---

<div class="cursor" aria-hidden="true" data-cursor-root transition:persist>
  <div class="cursor__label"><span data-cursor-text></span></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (root && fine && !(root as any).__init) {
    (root as any).__init = true;
    document.documentElement.classList.add('has-cursor');
    const text = root.querySelector<HTMLElement>('[data-cursor-text]')!;
    let active = false;

    const move = (e: PointerEvent) => {
      root.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
    };

    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      move(e);
      const t = e.target as HTMLElement;
      const labelled = t.closest<HTMLElement>('[data-cursor]');
      const drag = t.closest<HTMLElement>('[data-drag]');
      const next = !!(labelled || drag);
      if (next) text.textContent = labelled?.dataset.cursor || drag?.dataset.drag || '';
      if (next !== active) {
        active = next;
        root.classList.toggle('is-active', active);
        root.classList.toggle('is-drag', !labelled && !!drag);
      }
    });
    document.addEventListener('pointerleave', () => {
      active = false;
      root.classList.remove('is-active', 'is-drag');
    });
    document.addEventListener('astro:before-swap', () => {
      active = false;
      root.classList.remove('is-active', 'is-drag');
    });
  }
</script>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    pointer-events: none;
  }
  .cursor__label {
    position: absolute;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin: -48px 0 0 -48px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transform: scale(0);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cursor.is-active .cursor__label {
    transform: scale(1);
  }
  .cursor.is-drag .cursor__label {
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    font-size: 11px;
  }

  /* системный курсор прячем только там, где показывается круг */
  :global(html.has-cursor [data-cursor]),
  :global(html.has-cursor [data-cursor] *),
  :global(html.has-cursor [data-drag]),
  :global(html.has-cursor [data-drag] *) {
    cursor: none;
  }
</style>
