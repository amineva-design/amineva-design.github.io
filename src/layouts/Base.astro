---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';
import { getSettings } from '../lib/content';
import { loc, switchPath, t, withBase, type Lang } from '../lib/i18n';
import { getImage } from 'astro:assets';
import ogCover from '../assets/site/og-cover.png';

interface Props {
  title?: string;
  description?: string;
  theme?: 'dark' | 'light';
  lang: Lang;
}

const { title, description, theme = 'light', lang } = Astro.props;
const s = await getSettings();
const name = loc(s, 'name', lang);
const fullTitle = title ? `${title} — ${name}` : `${name} — ${loc(s, 'role', lang)}`;
const desc = description || loc(s, 'intro', lang);
// превью ссылки в мессенджерах и соцсетях: обложка из scripts/og-cover.py
const og = await getImage({ src: ogCover, width: 1200, format: 'jpg', quality: 88 });
const path = Astro.url.pathname;
// Яндекс Метрика: номер счётчика задаётся в админке (Настройки), локально не подключается
const metrika = import.meta.env.PROD ? s.metrikaId.trim() : '';
const alt = (l: Lang) => new URL(switchPath(path, l), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      metrika && (
        <script is:inline define:vars={{ metrika }}>
          // Счётчик подключаем один раз; переходы между страницами без перезагрузки отправляем как просмотры
          if (!window.__ymInit) {
            window.__ymInit = true;
            (function (m, e, t, r, i, k, a) {
              m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
              m[i].l = 1 * new Date();
              k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);
            })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + metrika, 'ym');
            ym(metrika, 'init', { ssr: true, webvisor: true, clickmap: true, referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
            var prev = location.href;
            document.addEventListener('astro:page-load', function () {
              if (location.href === prev) return;
              ym(metrika, 'hit', location.href, { referer: prev, title: document.title });
              prev = location.href;
            });
          }
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="ru" href={alt('ru')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <meta name="theme-color" content="#141412" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="32x32" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      // Прячем элементы до анимации появления; если скрипт не загрузится — показываем всё через 3 с
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 3000);
      }
    </script>
  </head>
  <body>
    {metrika && <noscript><div><img src={`https://mc.yandex.ru/watch/${metrika}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>}
    <a class="visually-hidden" href="#main">{t(lang).skip}</a>
    <Header theme={theme} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    <Cursor />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
